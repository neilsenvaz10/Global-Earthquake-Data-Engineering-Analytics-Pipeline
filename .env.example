USGS_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_MIN_MAGNITUDE=2.5
USGS_EVENT_TYPE=earthquake
USGS_REQUEST_TIMEOUT_SECONDS=30
USGS_MAX_RETRIES=3
USGS_RETRY_BACKOFF_SECONDS=1
USGS_REQUEST_LIMIT=1000
BACKFILL_WINDOW_DAYS=1
STAGING_DIR=./data/staging
QUARANTINE_DIR=./data/quarantine
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=quaketrack
POSTGRES_USER=quaketrack_app
POSTGRES_PASSWORD=
LOG_LEVEL=INFO
RAW_ARCHIVE_DIR=./data/raw

# Optional Airflow profile (generate local secrets; never use literal placeholders)
AIRFLOW_METADATA_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
AIRFLOW_WEB_PORT=18080
AIRFLOW_TASK_RETRY_SECONDS=60
PIPELINE_SCHEDULE=0 * * * *
INCREMENTAL_LOOKBACK_HOURS=72
INCREMENTAL_BOOTSTRAP_HOURS=6
INCREMENTAL_STEP_HOURS=6
INGESTION_DELAY_MINUTES=10
ALLOW_FAILURE_SIMULATION=false

# Optional dashboard Docker profile; host Python defaults to 8501 in .streamlit/config.toml
STREAMLIT_PORT=8501
DASHBOARD_DB_USER=quaketrack_dashboard
DASHBOARD_DB_PASSWORD=
